# Backorder PCM - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# Flask Secret Keys (REQUIRED - Generate strong random strings)
SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_DIFFERENT_RANDOM_STRING

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backorder_pcm
DB_USER=pcm_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Or use full DATABASE_URL (overrides individual DB settings)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# ERP Systems - Syteline
SYTELINE_ENABLED=true
SYTELINE_SERVER=syteline-server
SYTELINE_DATABASE=SyteLine
SYTELINE_USERNAME=erp_user
SYTELINE_PASSWORD=CHANGE_PASSWORD

# ERP Systems - Mongus
MONGUS_ENABLED=false
MONGUS_BASE_URL=http://mongus-server/api
MONGUS_API_KEY=YOUR_API_KEY

# ERP Systems - Intranet
INTRANET_ENABLED=false
INTRANET_BASE_URL=http://intranet-server/api
INTRANET_USERNAME=api_user
INTRANET_PASSWORD=CHANGE_PASSWORD

# Email/Notifications (Optional)
SMTP_SERVER=smtp.empresa.com
SMTP_PORT=587
SMTP_USERNAME=backorder@empresa.com
SMTP_PASSWORD=CHANGE_PASSWORD

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment (development, production)
FLASK_ENV=production
